{{ form_start(form) }}
    {{ form_row(form.text) }}
    {{ form_row(form.explication) }}

    <h3>Réponses</h3>
    {# the data-index attribute is required for the JavaScript code below #}
    <ul class="answers"
        data-index="{{ form.answers|length > 0 ? form.answers|last.vars.name + 1 : 0 }}"
        data-prototype="{{ form_widget(form.answers.vars.prototype)|e('html_attr') }}"
    >
        {% for answer in form.answers %}
            <li>{{ form_row(answer.text) }}{{ form_row(answer.is_correct) }}</li>
        {% endfor %}
    </ul>

    <button type="button" class="add_item_link" data-collection-holder-class="answers">Add an answer</button>

    <button>{{ button_label|default('Save') }}</button>
{{ form_end(form) }}

<script>
    document
        .querySelectorAll('.add_item_link')
        .forEach(btn => {
            btn.addEventListener("click", addFormToCollection)
        });

    document
        .querySelectorAll('ul.answers li')
        .forEach((answer) => {
            addAnswerFormDeleteLink(answer)
        });

    function addFormToCollection(e) {
        const collectionHolder = document.querySelector('.' + e.currentTarget.dataset.collectionHolderClass);

        const item = document.createElement('li');

        item.innerHTML = collectionHolder
            .dataset
            .prototype
            .replace(
                /__name__/g,
                collectionHolder.dataset.index
            );

        collectionHolder.appendChild(item);

        collectionHolder.dataset.index++;

        // add a delete link to the new form
        addAnswerFormDeleteLink(item);
    }

    function addAnswerFormDeleteLink(item) {
        const removeFormButton = document.createElement('button');
        removeFormButton.innerText = 'Delete this answer';

        item.append(removeFormButton);

        removeFormButton.addEventListener('click', (e) => {
            e.preventDefault();
            // remove the li for the answer form
            item.remove();
        });
    }
</script>
