{% extends 'base.html.twig' %}

{% block title %}Credit index{% endblock %}

{% block body %}

    <div class="container">

        <h1>Credit index</h1>

        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Author_name</th>
                    <th>Source_url</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody>
                {% for credit in credits %}
                    <tr>
                        <td>{{ credit.id }}</td>
                        <td>{{ credit.authorName }}</td>
                        <td>{{ credit.sourceUrl }}</td>
                        <td>
                            <a href="{{ path('app_credit_show', {'id': credit.id}) }}">show</a>
                            <a href="{{ path('app_credit_edit', {'id': credit.id}) }}">edit</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4">no records found</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <a href="{{ path('app_credit_new') }}">Create new</a>

    </div>

{% endblock %}
