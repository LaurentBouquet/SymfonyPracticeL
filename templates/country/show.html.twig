{% extends 'base.html.twig' %}

{% block title %}{{"Country"|trans}}{% endblock %}

{% block body %}

    <div class="container">

        <h1>{{"Country"|trans}}</h1>

        <table class="table">
            <tbody>
                <tr>
                    <th>{{"Id"|trans}}</th>
                    <td>{{ country.id }}</td>
                </tr>
                <tr>
                    <th>{{"Name"|trans}}</th>
                    <td>{{ country.name }}</td>
                </tr>
            </tbody>
        </table>

        <a class="btn btn-secondary mt-2" href="{{ path('app_country_index') }}">{{ "Back to list"|trans }}</a>

        <a class="btn btn-warning mt-2" href="{{ path('app_country_edit', {'id': country.id}) }}">{{ "edit"|trans }}</a>

        {{ include('country/_delete_form.html.twig') }}

    </div>

{% endblock %}
