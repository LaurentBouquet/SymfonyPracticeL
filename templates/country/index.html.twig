{% extends 'base.html.twig' %}

{% block title %}Country index{% endblock %}

{% block body %}

    <div class="container">

        <h1>{{ "Country index"|trans }}</h1>

        <table class="table">
            <thead>
                <tr>
                    <th>{{ "Id"|trans }}</th>
                    <th>{{ "Name"|trans }}</th>
                    <th>{{ "Actions"|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for country in countries %}
                    <tr>
                        <td>{{ country.id }}</td>
                        <td>{{ country.name }}</td>
                        <td>
                            <a href="{{ path('app_country_show', {'id': country.id}) }}" class="btn btn-info btn-sm" title="{{ 'show'|trans }}">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                            <a href="{{ path('app_country_edit', {'id': country.id}) }}" class="btn btn-warning btn-sm" title="{{ 'edit'|trans }}">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3">{{ "no records found"|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <a href="{{ path('app_country_new') }}"><button class="btn btn-primary">{{ "Create new"|trans }}</button></a>

    </div>

{% endblock %}
