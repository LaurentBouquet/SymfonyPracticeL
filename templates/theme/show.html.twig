{% extends 'base.html.twig' %}

{% block title %}{{ "Theme"|trans }}{% endblock %}

{% block body %}
    <h1>{{ "Theme"|trans }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{{ "Id"|trans }}</th>
                <td>{{ theme.id }}</td>
            </tr>
            <tr>
                <th>{{ "Title"|trans }}</th>
                <td>{{ theme.title }}</td>
            </tr>
            <tr>
                <th>{{ "Description"|trans }}</th>
                <td>{{ theme.description }}</td>
            </tr>
            <tr>
                <th>Step"|trans }}</th>
                <td>{{ theme.step }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_theme_index') }}">{{ "back to list"|trans }}</a>

    <a href="{{ path('app_theme_edit', {'id': theme.id}) }}">{{ "edit"|trans }}</a>

    {{ include('theme/_delete_form.html.twig') }}
{% endblock %}
