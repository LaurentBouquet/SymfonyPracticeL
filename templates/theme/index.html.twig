{% extends 'base.html.twig' %}

{% block title %}{{ "Theme index"|trans }}{% endblock %}

{% block body %}
    <h1>{{ "Theme index"|trans }}</h1>

    <table class="table">
        <thead>
            <tr>
                <th>{{ "Id"|trans }}</th>
                <th>{{ "Title"|trans }}</th>
                <th>{{ "Description"|trans }}</th>
                <th>{{ "Step"|trans }}</th>
                <th>{{ "actions"|trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for theme in themes %}
            <tr>
                <td>{{ theme.id }}</td>
                <td>{{ theme.title }}</td>
                <td>{{ theme.description }}</td>
                <td>{{ theme.step }}</td>
                <td>
                    <a href="{{ path('app_theme_show', {'id': theme.id}) }}">{{ "show"|trans }}</a>
                    <a href="{{ path('app_theme_edit', {'id': theme.id}) }}">{{ "edit"|trans }}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">{{ "no records found"|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_theme_new') }}">{{ "Create new"|trans }}</a>
{% endblock %}
