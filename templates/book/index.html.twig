{% extends 'base.html.twig' %}

{% block title %}Book index{% endblock %}

{% block body %}

    <div class="container">

        <h1>{{ "Book index"|trans }}</h1>

        <table class="table">
            <thead>
                <tr>
                    <th>{{ "Id"|trans }}</th>
                    <th>{{ "Title"|trans }}</th>
                    <th>{{ "Nbrpages"|trans }}</th>
                    <th>{{ "Actions"|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for book in books %}
                    <tr>
                        <td>{{ book.id }}</td>
                        <td>{{ book.title }}</td>
                        <td>{{ book.nbrpages }}</td>
                        <td>
                            <a href="{{ path('app_book_show', {'id': book.id}) }}" class="btn btn-info btn-sm" title="{{ 'show'|trans }}">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                            <a href="{{ path('app_book_edit', {'id': book.id}) }}" class="btn btn-warning btn-sm" title="{{ 'edit'|trans }}">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3">{{ "no records found"|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <a href="{{ path('app_book_new') }}"><button class="btn btn-primary">{{ "Create new"|trans }}</button></a>


    </div>

{% endblock %}
